ENV=development
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=120
INTERNAL_SERVICE_TOKEN=

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/klawva
REDIS_URL=redis://localhost:6379/0

FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_API_BASE_URL=http://localhost:8000
TELEGRAM_BOT_TOKEN_POOL=
HISTORY_MAGIC_LINK_SECRET=
HISTORY_MAGIC_LINK_TTL_MINUTES=20

DIGITALOCEAN_API_TOKEN=
DIGITALOCEAN_API_BASE_URL=https://api.digitalocean.com
DIGITALOCEAN_REGION=nyc1
DIGITALOCEAN_DROPLET_SIZE=s-2vcpu-4gb
DIGITALOCEAN_OPENCLAW_IMAGE=openclaw
DIGITALOCEAN_SSH_KEY_FINGERPRINTS=
PROVISIONING_MAX_RETRIES=3
DROPLET_MAX_SESSIONS=5
DROPLET_AGENT_GATEWAY_PORT=9090

GRADIENT_MODEL_ACCESS_KEY=
GRADIENT_BASE_URL=https://inference.do-ai.run
GRADIENT_PREFERRED_MODEL=openai-gpt-oss-120b
GRADIENT_FALLBACK_MODEL=openai-gpt-oss-20b

NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
NOMBA_BASE_URL=https://api.nomba.com
NOMBA_WEBHOOK_SECRET=
NOMBA_SUBACCOUNT_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Klawva
CONTACT_RECIPIENT_EMAIL=

BRIDGE_INTERNAL_TOKEN=
BRIDGE_INTERNAL_TOKEN_FILE=/etc/openclaw/gateway_token
BRIDGE_SESSIONS_DIR=/etc/openclaw/sessions
BRIDGE_GATEWAY_PORT=9090
BRIDGE_TELEGRAM_POLL_TIMEOUT_SECONDS=25
BRIDGE_TELEGRAM_POLL_PAUSE_SECONDS=2
