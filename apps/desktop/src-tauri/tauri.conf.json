{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klawva",
  "version": "0.1.0",
  "identifier": "xyz.klawva.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Klawva",
        "width": 900,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://klawva.xyz wss://klawva.xyz"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": []
  }
}
