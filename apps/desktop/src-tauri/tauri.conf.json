{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klawva",
  "version": "0.1.0",
  "identifier": "xyz.klawva.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Klawva",
        "width": 900,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://klawva.xyz wss://klawva.xyz http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https://gmail.googleapis.com https://oauth2.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
