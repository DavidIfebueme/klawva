{
  "ignoreCommand": "git diff --quiet \"origin/${VERCEL_GIT_COMMIT_REF}\":./ -- . 2>/dev/null && exit 1 || exit 0",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://klawva.klawva.workers.dev/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "git diff --quiet \"origin/$VERCEL_GIT_COMMIT_REF\"...HEAD -- . && exit 1 || exit 0"
}
